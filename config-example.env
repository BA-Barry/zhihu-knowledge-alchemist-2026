# 从 https://developer.zhihu.com/profile 获取。不要提交真实值。
ZHIHU_ACCESS_SECRET=在这里填写AccessSecret

# 官方地址通常无需修改。
ZHIHU_API_BASE_URL=https://developer.zhihu.com

# 可选：知乎直答模型。
ZHIHU_ANSWER_MODEL=zhida-fast-1p5

# 可选：为公开体验保留官方日配额余量。
ZHIHU_DAILY_LIMIT_DIRECT_ANSWER=80
ZHIHU_DAILY_LIMIT_ZHIHU_SEARCH=800
ZHIHU_DAILY_LIMIT_GLOBAL_SEARCH=800
ZHIHU_DAILY_LIMIT_HOT_LIST=80

# 可选：公网容器监听配置。
HOST=0.0.0.0
PORT=8765

# 可选：SQLite 数据目录。
# ZHIHU_KNOWLEDGE_HOME=/data
